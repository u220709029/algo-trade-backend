spring.application.name=algo-trade-backend
server.port=8080

# ============================================================
# Bu dosyayı kopyalayıp 'application.properties' olarak kaydedin.
# Kendi Binance Testnet API anahtarlarınızı aşağıya girin.
# 'application.properties' Git tarafından takip EDİLMEZ (.gitignore).
# ============================================================

# Binance API Anahtarları (Binance Testnet > API Management)
binance.api.key=BURAYA_BINANCE_API_KEYINIZI_YAZIN
binance.api.secret=BURAYA_BINANCE_SECRET_KEYINIZI_YAZIN
binance.api.base-url=https://testnet.binance.vision
binance.api.testnet=true

# Log seviyesi yapılandırması
logging.level.com.example.demo=DEBUG
